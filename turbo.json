{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "tsconfig.base.json",
    ".prettierrc",
    ".github/workflows/**",
    "Dockerfile",
    "Dockerfile.admin",
    "scripts/*.mjs",
    "deploy/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/prisma/**", ".vitepress/dist/**"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@nove/admin#build": {
      "dependsOn": ["generate:client"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ],
      "env": ["VITE_*", "NODE_ENV"],
      "outputs": ["dist/**"]
    },
    "@nove/api#generate:openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi/openapi.json"]
    },
    "@nove/api#lint": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nove/api#lint:prisma": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nove/api#format:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nove/api#test": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@nove/admin#generate:client": {
      "dependsOn": ["@nove/api#generate:openapi"],
      "outputs": ["src/shared/lib/api/orval/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@nove/admin#lint": {
      "dependsOn": ["generate:client"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@nove/admin#test": {
      "dependsOn": ["build", "lint"],
      "cache": false,
      "passThroughEnv": ["*"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@nove/admin#dev": {
      "dependsOn": ["generate:client"],
      "cache": false,
      "passThroughEnv": ["*"],
      "persistent": true
    }
  }
}
