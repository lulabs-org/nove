{
  "name": "nove-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "format": "pnpm --filter @nove/api run format",
    "start": "pnpm --filter @nove/api run start",
    "start:dev": "pnpm --filter @nove/api run start:dev",
    "start:debug": "pnpm --filter @nove/api run start:debug",
    "start:prod": "pnpm --filter @nove/api run start:prod",
    "lint": "turbo run lint",
    "lint:prisma": "pnpm --filter @nove/api run lint:prisma",
    "compodoc": "pnpm --filter @nove/api run compodoc",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @nove/api run test:watch",
    "test:cov": "pnpm --filter @nove/api run test:cov",
    "test:debug": "pnpm --filter @nove/api run test:debug",
    "test:unit": "pnpm --filter @nove/api run test:unit",
    "test:unit:watch": "pnpm --filter @nove/api run test:unit:watch",
    "test:integration": "pnpm --filter @nove/api run test:integration",
    "test:integration:watch": "pnpm --filter @nove/api run test:integration:watch",
    "test:system": "pnpm --filter @nove/api run test:system",
    "test:system:watch": "pnpm --filter @nove/api run test:system:watch",
    "test:e2e": "pnpm --filter @nove/api run test:e2e",
    "test:oauth:e2e": "pnpm --filter @nove/api run test:oauth:e2e",
    "test:all": "pnpm --filter @nove/api run test:all",
    "test:ci": "pnpm --filter @nove/api run test:ci",
    "db:generate": "pnpm --filter @nove/api run db:generate",
    "db:push": "pnpm --filter @nove/api run db:push",
    "db:migrate": "pnpm --filter @nove/api run db:migrate",
    "db:migrate:status": "pnpm --filter @nove/api run db:migrate:status",
    "db:migrate:prod": "pnpm --filter @nove/api run db:migrate:prod",
    "db:studio": "pnpm --filter @nove/api run db:studio",
    "db:reset": "pnpm --filter @nove/api run db:reset",
    "db:seed": "pnpm --filter @nove/api run db:seed",
    "db:seed:real": "pnpm --filter @nove/api run db:seed:real",
    "db:backup": "pnpm --filter @nove/api run db:backup",
    "mcp:inspect": "pnpm --filter @nove/api run mcp:inspect",
    "mcp:inspect:dev": "pnpm --filter @nove/api run mcp:inspect:dev",
    "mcp:inspect:sse": "pnpm --filter @nove/api run mcp:inspect:sse",
    "mcp:inspect:http": "pnpm --filter @nove/api run mcp:inspect:http",
    "format:check": "pnpm --filter @nove/api run format:check",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @nove/api run start:dev",
    "dev:admin": "turbo run dev --filter=@nove/admin",
    "build:api": "pnpm --filter @nove/api run build",
    "build:admin": "turbo run build --filter=@nove/admin",
    "generate:api": "turbo run generate:client --filter=@nove/admin",
    "docs:dev": "pnpm --filter @nove/docs run docs:dev",
    "docs:build": "pnpm --filter @nove/docs run docs:build",
    "prisma": "pnpm --filter @nove/api exec prisma",
    "compose": "docker compose --env-file apps/api/.env",
    "test:admin": "turbo run test --filter=@nove/admin",
    "lint:admin": "turbo run lint --filter=@nove/admin",
    "generate:openapi": "turbo run generate:openapi --filter=@nove/api",
    "ci:scope": "node scripts/ci-scope.mjs",
    "test:workspace": "node --test scripts/*.test.mjs",
    "skills:check": "pnpm --filter @nove/skills run check",
    "skills:test": "pnpm --filter @nove/skills run test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "2.11.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
