{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["src/*"],
      "@common/*": ["src/common/*"],
      "@casl/ability": ["node_modules/@casl/ability/dist/types/index.d.ts"],
      "@casl/prisma": ["node_modules/@casl/prisma/dist/types/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "jest.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "docs", "documentation"]
}
