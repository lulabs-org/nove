// =============================================================================
// 关联中间表（Junction Tables）
// 本文件存放所有多对多关系的中间表 model，包括：
//   - MemberDepartment   成员 ↔ 部门
//   - MemberRole         成员 ↔ 角色
//   - RolePermission     角色 ↔ 权限
//   - MemberPermission   成员 ↔ 权限（特殊授权）
//   - RoleDataPermission     角色 ↔ 数据权限规则
//   - MemberDataPermission   成员 ↔ 数据权限规则
//   - OrderTagLink           订单 ↔ 订单标签
// =============================================================================

// 成员部门关联表
model MemberDepartment {
  id        String  @id @default(cuid())
  memberId  String  @map("member_id") // 成员ID
  deptId    String  @map("dept_id") // 部门ID
  orgId     String  @map("org_id") // 所属组织ID
  isPrimary Boolean @default(false) // 是否主要部门

  // 关联关系
  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dept   Dept      @relation(fields: [deptId], references: [id], onDelete: Cascade)
  org    Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([memberId, deptId])
  @@index([memberId])
  @@index([deptId])
  @@index([orgId]) // 组织索引，避免跨组织误关联
  @@index([orgId, memberId]) // 组织内成员查询
  @@index([orgId, deptId]) // 组织内部门查询
  @@map("member_departments")
}

// 成员角色关联表
model MemberRole {
  id       String @id @default(cuid())
  memberId String @map("member_id") // 成员ID
  roleId   String @map("role_id") // 角色ID

  // 关联关系
  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([memberId, roleId])
  @@index([memberId])
  @@index([roleId])
  @@map("member_roles")
}

// 角色权限关联表
model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id") // 角色ID
  permissionId String @map("permission_id") // 权限ID

  // 关联关系
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// 成员权限关联表（用于特殊权限授权）
model MemberPermission {
  id           String  @id @default(cuid())
  memberId     String  @map("member_id") // 成员ID
  permissionId String  @map("permission_id") // 权限ID
  granted      Boolean @default(true) // 是否授权（true: 授权, false: 拒绝）

  // 关联关系
  member     OrgMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([memberId, permissionId])
  @@index([memberId])
  @@index([permissionId])
  @@map("member_permissions")
}

// 角色数据权限关联表
model RoleDataPermission {
  id     String @id @default(cuid())
  roleId String @map("role_id") // 角色ID
  ruleId String @map("rule_id") // 数据权限规则ID

  // 关联关系
  role Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  rule DataPermissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([roleId, ruleId])
  @@index([roleId])
  @@index([ruleId])
  @@map("role_data_permissions")
}

// 成员数据权限关联表
model MemberDataPermission {
  id       String  @id @default(cuid())
  memberId String  @map("member_id") // 成员ID
  ruleId   String  @map("rule_id") // 数据权限规则ID
  granted  Boolean @default(true) // 是否授权

  // 关联关系
  member OrgMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rule   DataPermissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间戳

  @@unique([memberId, ruleId])
  @@index([memberId])
  @@index([ruleId])
  @@map("member_data_permissions")
}

// 订单标签关联表
// 标签整体替换时直接删除重建关联，不做软删除；position 保留用户录入顺序
model OrderTagLink {
  id       String @id @default(cuid())
  orderId  String @map("order_id") // 订单ID
  tagId    String @map("tag_id") // 标签ID
  position Int    @default(0) // 标签在订单内的展示顺序（从 0 开始）

  order Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag   OrderTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orderId, tagId])
  @@index([tagId]) // 按标签筛选订单、按可见订单反查标签
  @@map("order_tag_links")
}
